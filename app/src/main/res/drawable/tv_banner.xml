<?xml version="1.0" encoding="utf-8"?>
<!-- The Android TV launcher banner (320 × 180 dp): the icon's gradient crescent on plain white,
     with the same proportion as the launcher icon (furthest point at 48.7% of the banner's half
     height). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M0,0h320v180h-320z" />
    <!-- The crescent's centre (53.375, 54) goes to the banner's centre (160, 90); the moon is drawn
         1.662 times the launcher's size so its furthest point is 43.8 from the centre. -->
    <group
        android:pivotX="53.375"
        android:pivotY="54"
        android:translateX="106.625"
        android:translateY="36"
        android:scaleX="1.662"
        android:scaleY="1.662">
      <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.86"
        android:scaleY="0.86">
        <path android:pathData="M54.72,24.01 A30,30 0 1,0 82.6,63.05 A24,24 0 1,1 54.72,24.01 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="24"
                    android:startY="24"
                    android:endX="84"
                    android:endY="84">
                <item android:color="#FFB388FF" android:offset="0" />
                <item android:color="#FF7C4DFF" android:offset="0.5" />
                <item android:color="#FF4527A0" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
      </group>
    </group>
</vector>
