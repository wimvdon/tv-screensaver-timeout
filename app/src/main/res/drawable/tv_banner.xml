<?xml version="1.0" encoding="utf-8"?>
<!-- The Android TV launcher banner (320 × 180 dp): the icon's gradient crescent, twice the size of
     the launcher icon's, centred on the icon's soft violet plate. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">
    <path android:pathData="M0,0h320v180h-320z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="320"
                android:endY="180">
                <item android:color="#FFF2EDFF" android:offset="0" />
                <item android:color="#FFE5DBFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Moves the icon's centre (54, 54) to the banner's centre (160, 90) at 2 × 0.86. -->
    <group
        android:translateX="67.12"
        android:translateY="-2.88"
        android:scaleX="1.72"
        android:scaleY="1.72">
        <path android:pathData="M54.72,24.01 A30,30 0 1,0 82.6,63.05 A24,24 0 1,1 54.72,24.01 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="24"
                    android:startY="24"
                    android:endX="84"
                    android:endY="84">
                <item android:color="#FFB388FF" android:offset="0" />
                <item android:color="#FF7C4DFF" android:offset="0.5" />
                <item android:color="#FF4527A0" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
